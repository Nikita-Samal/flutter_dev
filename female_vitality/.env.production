# Female Vitality Production Environment
ENVIRONMENT=production
APP_NAME=Female Vitality
APP_VERSION=1.0.0

HEALTH_API_BASE_URL=https://api.femalevitality.com/api/v1
HEALTH_API_TIMEOUT_MS=15000
AUTH_HEADER_PREFIX=Bearer

FIREBASE_PROJECT_ID=female-vitality-prod
FIREBASE_STORAGE_BUCKET=female-vitality-prod.appspot.com

ENABLE_MOCK_HEALTH_SERVICE=false
ENABLE_OFFLINE_PERSISTENCE=true
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
