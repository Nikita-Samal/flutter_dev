# Female Vitality Staging Environment
ENVIRONMENT=staging
APP_NAME=Female Vitality (Staging)
APP_VERSION=1.0.0-staging

HEALTH_API_BASE_URL=https://api-staging.femalevitality.com/api/v1
HEALTH_API_TIMEOUT_MS=15000
AUTH_HEADER_PREFIX=Bearer

FIREBASE_PROJECT_ID=female-vitality-staging
FIREBASE_STORAGE_BUCKET=female-vitality-staging.appspot.com

ENABLE_MOCK_HEALTH_SERVICE=false
ENABLE_OFFLINE_PERSISTENCE=true
ENABLE_ANALYTICS=true
ENABLE_CRASHLYTICS=true
